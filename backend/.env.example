FLASK_ENV=development
SECRET_KEY=campusconnect-secret-key-change-in-production
JWT_SECRET_KEY=campusconnect-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
PORT=5000

# SQLite (Default for turnkey local execution)
DATABASE_URL=sqlite:///campusconnect.db

# MySQL 8+ (For Production / Local MySQL)
# DATABASE_URL=mysql+pymysql://campus_user:campus_password@localhost:3306/campusconnect_db

UPLOAD_FOLDER=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
